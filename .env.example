# Ce que l'application attend pour demarrer.
#
# POURQUOI CE FICHIER EXISTE. Le 22 aout 2026, le code referencait 49 variables
# — 44 recensees le matin, et QUATRE DE PLUS trouvees le soir en tracant le
# parcours de commande de bout en bout. Ce sont justement celles qui portent
# l'appel aux livreurs. Un manifeste incomplet ne se voit pas : il se decouvre
# le jour ou l'on reconstruit, et il manque toujours ce qui compte.
#
# Avant elles, le code referencait 44 variables
# et rien ne les listait nulle part : ni ici, ni dans un document. Reconstruire
# l'environnement apres un incident revenait a lire tout le code pour deviner ce
# qui manquait — et une variable manquante ne se voit pas au demarrage, elle se
# voit quand un marchand perd une commande.
#
# Il ne contient AUCUNE valeur, seulement des noms et ce a quoi ils servent.
# Les valeurs vivent dans Vercel (production) et dans .env.local (poste), qui
# n'est pas versionne.

# ---- Supabase --------------------------------------------------------------
# L'URL est un domaine maison (auth.djiguiflow.com), pas l'URL *.supabase.co.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Contourne RLS : elle ne doit JAMAIS porter le prefixe NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Utilisee par scripts/types-supabase.mjs et scripts/verifier-migrations.mjs.
SUPABASE_PROJECT_ID=

# ---- Le secret partage avec n8n --------------------------------------------
# Exige par toutes les routes /api/internal/* et /api/canaux/envoyer.
SYNC_SECRET=

# ---- Les webhooks n8n qui portent le PARCOURS DE COMMANDE -------------------
#
# CES QUATRE-LA MANQUAIENT, et c'est le trou le plus couteux de ce fichier.
# Constate le 22 aout 2026 en tracant le parcours de bout en bout.
#
# Le code les lit ainsi, aux deux bouts de la prise de commande :
#
#     const n8nUrl = boutiqueEssai ? null : process.env.N8N_COMMANDE_APP_URL;
#     if (n8nUrl) { ... }
#
# Variable absente : le bloc est SAUTE. Pas d'erreur, pas de journal, pas
# d'alerte. La commande est enregistree, le stock decompte, le marchand
# prevenu — et AUCUN LIVREUR N'EST APPELE, aucun client n'est confirme. Une
# plateforme qui prend des commandes et n'en livre aucune, sans rien dire.
#
# Elles sont posees en production et la chaine fonctionne (verifie le 22 aout).
# Le danger est la reconstruction : ce fichier EST le manifeste depuis lequel on
# rebatit apres incident, et il decrivait un environnement muet.
#
# Le filet de securite existe et il est reel : « Veille des chaines » detecte
# `sans_livreur` et `client_non_prevenu` toutes les quinze minutes. Il rattrape
# la panne, il ne l'empeche pas.
N8N_COMMANDE_APP_URL=
N8N_CONFIRMATION_URL=
# Le routeur Telegram. Son URL porte l'identifiant du noeud ET le slug de la
# boutique : `/webhook/<id>/telegram/<slug>`. La forme courte `/webhook/telegram`
# repond 404 — sonder la mauvaise fait croire, a tort, que le routeur est mort.
N8N_TELEGRAM_WEBHOOK_URL=
# Repli du secret des webhooks quand le coffre Supabase est injoignable.
# La source de verite reste le coffre : voir src/lib/secretN8n.ts.
N8N_WEBHOOK_SECRET=
#
# `N8N_NOTIF_CLIENT_URL` a disparu du code : elle pointait vers un chemin
# `notif-client` qui n'a jamais existe, et chaque changement de statut partait
# dans le vide sans que rien ne leve. Ne pas la reintroduire — les statuts
# passent maintenant par `envoyerMessage`, dont l'echec se voit.

# ---- Canaux ----------------------------------------------------------------
# Jetons de la PLATEFORME, servant de repli tant qu'un marchand n'a pas connecte
# les siens. Les jetons des marchands vivent dans le coffre Supabase, jamais ici.
WASENDER_API_KEY=
TELEGRAM_BOT_TOKEN=

# ---- L'assistante ----------------------------------------------------------
MISTRAL_API_KEY=
MISTRAL_MODEL=
# Plafonds du point d'entree public de l'assistante.
ASSISTANT_RAFALE_LIMITE=
ASSISTANT_PLAFOND_JOURNALIER=

# ---- Google Sheets (miroir, jamais bloquant) -------------------------------
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
SHEET_ID=

# ---- Paiements -------------------------------------------------------------
# `mock` en recette, `reel` en production.
BILLING_MODE=
NEXT_PUBLIC_BILLING_MODE=
GENIUSPAY_API_KEY=
GENIUSPAY_API_SECRET=
GENIUSPAY_WEBHOOK_SECRET=
GENIUSPAY_ACCEPTE_SANDBOX=
CINETPAY_API_KEY=
CINETPAY_SECRET_KEY=
CINETPAY_SITE_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PREMIUM=
SUPABASE_SUBSCRIPTIONS_TABLE=

# ---- Notifications poussees ------------------------------------------------
# La cle publique existe en deux exemplaires A DESSEIN : le navigateur lit la
# NEXT_PUBLIC_, le serveur lit l'autre. Toute variable ajoutee dans Vercel exige
# un redeploiement pour etre vue.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=

# ---- Veille et alertes -----------------------------------------------------
# Le bot de veille de la plateforme, distinct de tout bot de marchand.
TELEGRAM_ALERTE_TOKEN=
TELEGRAM_ALERTE_CHAT_ID=
VEILLE_TOLERANCE_MIN=
VEILLE_CANARI=
# A ne poser que pour eprouver l'alerte elle-meme.
VEILLE_FORCER_ALERTE=

# ---- Site ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_APP_URL=
# Le numero affiche, et celui vers lequel le bouton « Appeler » compose.
# Forme lisible : elle est montree telle quelle au visiteur.
#   NEXT_PUBLIC_SUPPORT_PHONE=+225 01 02 91 88 86
NEXT_PUBLIC_SUPPORT_PHONE=

# CE QUE CETTE VARIABLE CHANGE, ET C'EST PLUS QU'UN NUMERO.
#
# Vide, le bouton de l'assistante dit « Conseiller » et ouvre un COURRIEL vers
# support@djiguiflow.com. Posee, il dit « Nous ecrire » et ouvre une
# conversation WhatsApp avec ce numero, message deja redige.
#
# En Cote d'Ivoire, personne n'ecrit un courriel a une boutique. Un visiteur
# qui a encore une question apres l'assistante part sur WhatsApp ou ne revient
# pas. Le courriel reste le repli, et il reste dans les documents legaux pour
# ce qui est formel.
#
# Format international SANS le plus : les caracteres non numeriques sont
# retires avant de composer le lien wa.me.
#   NEXT_PUBLIC_SUPPORT_WHATSAPP=2250102918886
#
# Elle est PUBLIQUE par construction (prefixe NEXT_PUBLIC_) : ce numero sera
# lisible par tout visiteur. C'est le but, et c'est deja celui des mentions
# legales — mais ne posez pas ici un numero que vous ne voulez pas voir
# afficher.
NEXT_PUBLIC_SUPPORT_WHATSAPP=
GOOGLE_SITE_VERIFICATION=
# Les adresses qui ouvrent les ecrans d'administration, separees par une virgule.
ADMIN_EMAILS=

# ---- Suite de tests de bout en bout ---------------------------------------
# Sans elles, la suite authentifiee se saute proprement au lieu d'echouer.
E2E_EMAIL=
E2E_PASSWORD=

# ---- Fournies par la plateforme, a ne pas poser a la main ------------------
#
# Le code en reference dix de plus, et aucune ne se pose ici. La liste est
# exhaustive : `comm` entre les variables du code et celles de ce fichier ne
# doit rendre que celles-ci.
#
#   NODE_ENV                      Node
#   VERCEL_ENV, VERCEL_URL,
#   VERCEL_GIT_COMMIT_REF,
#   VERCEL_GIT_COMMIT_SHA,
#   VERCEL_GIT_REPO_OWNER,
#   VERCEL_GIT_REPO_SLUG          Vercel
#   GITHUB_EVENT_NAME             GitHub Actions
#   BASE                          molette des scripts : vise un autre hote
#                                 (BASE=http://localhost:3000 node scripts/…)
#   N                             variable locale d'un script, jamais posee
#
# ---- Secrets du depot, poses par `gh secret set` ---------------------------
#   N8N_API_KEY, N8N_API_URL      export quotidien des workflows
#   SUPABASE_ACCESS_TOKEN         garde de schema et sauvegarde de reference
