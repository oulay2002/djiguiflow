      {
        "id": "964c6855-5c79-46b8-bc48-1ecaac8dab7a",
        "name": "Feuilles à nettoyer",
        "parameters": {
          "jsCode": "const vues = new Set();\nconst cibles = [];\n\nfor (const m of ($input.first().json.marchands) || []) {\n  const doc = String(m.sheetId || '').trim();\n  const onglet = String(m.sheetCommandes || '').trim();\n  if (!doc || !onglet) continue;\n\n  const cle = doc + '::' + onglet;\n  if (vues.has(cle)) continue;\n  vues.add(cle);\n\n  cibles.push({ json: { slug: String(m.id || ''), document: doc, onglet } });\n}\n\nreturn cibles;"
        },
        "position": [
          -128,
          176
        ],
        "type": "n8n-nodes-base.code",
        "typeVersion": 2
