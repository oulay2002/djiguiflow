      {
        "alwaysOutputData": true,
        "id": "591303fb-4494-4ec5-9af4-07b98e4b356d",
        "name": "Lignes vides",
        "parameters": {
          "jsCode": "const cible = $('Boucle feuilles').first().json;\nconst rows = $input.all().map(i => i.json).filter(r => r && Object.keys(r).length);\n\n// Feuille vide : rien a faire, et surtout rien a supprimer.\nif (!rows.length) return [];\n\n// Lecture impossible — onglet absent chez un marchand pas encore provisionne.\n// Le noeud de lecture tolere l'erreur et la transmet : on passe a la feuille\n// suivante. Sans cette distinction, l'echec serait pris pour une colonne\n// disparue et arreterait le nettoyage de toutes les autres boutiques.\nif (rows.length === 1 && rows[0].error && !('order_id' in rows[0])) {\n  console.log(`Hygiene ${cible.onglet} : lecture impossible (${rows[0].error}) — feuille ignoree.`);\n  return [];\n}\n\n// LES MESSAGES CI-DESSOUS N'ONT NI DEUX-POINTS NI RETOUR A LA LIGNE.\n// n8n scinde le texte d'une Error sur ces caracteres, et « Alerte Erreurs » ne\n// recevait alors que « Unknown error » — au moment precis ou il faut savoir\n// quelle feuille a ete epargnee et combien de lignes etaient en cause. Le\n// tiret cadratin, lui, traverse le neutraliseur de l'alerte.\n\n// Garde-fou 1 : si la colonne order_id a disparu (renommage, lecture degradee),\n// toutes les lignes paraitraient vides. On refuse de supprimer.\nif (!Object.prototype.hasOwnProperty.call(rows[0], 'order_id')) {\n  throw new Error(`Colonne order_id absente sur ${cible.onglet} — suppression annulee`);\n}\n\nconst vides = rows\n  .filter(r => !String(r.order_id || '').trim())\n  .sort((a, b) => (Number(b.row_number) || 0) - (Number(a.row_number) || 0));\n\n// Garde-fou 2 : une purge massive signale une anomalie, pas du menage.\nconst plafond = Math.max(20, Math.ceil(rows.length * 0.3));\nif (vides.length > plafond) {\n  throw new Error(`Anomalie sur ${cible.onglet} — ${vides.length} lignes sans order_id sur ${rows.length} au total, plafond ${plafond} — suppression annulee`);\n}\n\n// Les suppressions partent du bas : supprimer une ligne decale toutes celles\n// qui la suivent.\nreturn vides.map(r => ({ json: { row_number: r.row_number, onglet: cible.onglet } }));"
        },
        "position": [
          416,
          288
        ],
        "type": "n8n-nodes-base.code",
        "typeVersion": 2
      },
