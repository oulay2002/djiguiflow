      "id": "1ab2b48c-75e0-4f10-bda0-d59dd43094f1",
      "name": "Composer les relances",
      "parameters": {
        "jsCode": "const echeances = $('Echeances du jour').first().json.echeances || [];\nif (!echeances.length) return [];\n\n// Ou joindre chaque marchand. Une relance ne doit jamais partir vers le chat\n// d'une autre boutique que celle dont elle parle.\nconst annuaire = {};\nfor (const m of ($('Lire le registre').first().json.marchands) || []) {\n  annuaire[String(m.id || '').trim()] = m;\n}\n\nreturn echeances.map((e) => {\n  const m = annuaire[String(e.slug || '').trim()] || {};\n  return { json: {\n    slug: String(e.slug || '').trim(),\n    message: String(e.message || ''),\n    telegram: String(m.telegramMarchand || '').trim(),\n    whatsapp: String(m.whatsapp || '').trim(),\n  } };\n});"
      },
      "position": [
        672,
        96
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
