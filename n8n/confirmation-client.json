    {
      "id": "02b77946-bc72-432f-bdc8-9f1481d563bf",
      "name": "Code in JavaScript",
      "parameters": {
        "jsCode": "const wh = $('Webhook').first().json;\nlet b = wh.body || wh;\n\n// La commande arrive parfois serialisee dans un champ confirmation, avec un\n// signe egal en tete herite d'une expression n8n.\nif (b.confirmation) {\n  let s = typeof b.confirmation === 'string' ? b.confirmation.trim() : null;\n  if (s && s.startsWith('=')) s = s.slice(1).trim();\n  try {\n    if (s) b = JSON.parse(s);\n    else if (typeof b.confirmation === 'object') b = b.confirmation;\n  } catch (e) {}\n}\n\n// Le contexte vient de l'application, plus de l'onglet Marchands : une\n// feuille renommee ne casse plus la confirmation d'une commande.\nconst m = $('Contexte boutique').first().json || {};\n\nconst out = { ...b };\nout.reference = b.reference || b.order_id || '';\nout.phone = b.phone || b.chat_id || b.destinataire || '';\nout.nom = b.nom || b.customer_name || 'Client';\nout.total = b.total ?? b.total_price ?? 0;\nout.slug = String(m.slug || '');\nout.whatsapp_marchand = String(m.telephone || '');\nout.nom_boutique = String(m.nom || '');\n\n// Groupe de livreurs du marchand. Il etait lu mais jamais transmis a\n// « Lancer livreurs », qui recevait donc null : Telegram repondait\n// « chat not found » et aucun livreur n'etait alerte.\nout.groupe_livreurs = String(m.groupe_livreurs || '');\n\n// JID WhatsApp FIABLE du client : le chat qui parle au bot,\n// sinon le telephone saisi normalise (0... -> 225...)\nconst telBrut = String(out.phone || '').trim();\nout.whatsapp_client = String(b.chat_id || '').trim()\n  || (telBrut.startsWith('0') ? '225' + telBrut : telBrut);\n\n// CANAL REEL DU CLIENT. Les notifications partaient en dur sur WhatsApp,\n// alors que le lien de confirmation vise le chat_id. Une commande passee sur\n// Telegram voyait donc son lien expedie a WaSender comme si l'identifiant\n// Telegram etait un numero : l'envoi echouait, le client ne recevait rien, ne\n// confirmait jamais, et la commande restait en suspens en silence.\nout.canal_client = String(b.canal || '').trim().toLowerCase() === 'telegram'\n  ? 'telegram'\n  : 'whatsapp';\n\nout.destinataire_client = out.canal_client === 'telegram'\n  ? String(b.chat_id || b.destinataire || '').trim()\n  : out.whatsapp_client;\n\nreturn [{ json: out }];"
      },
      "position": [
        448,
        192
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
