      {
        "id": "f4e6d260-cd5b-4c49-89f0-f26137abd896",
        "name": "Composer les envois",
        "parameters": {
          "jsCode": "const contenus = $('Contenus de la semaine').first().json.contenus || [];\nif (!contenus.length) return [];\n\n// Ou joindre chaque marchand. Un contenu ne doit jamais partir vers le chat\n// d'une autre boutique que celle dont il parle.\nconst annuaire = {};\nfor (const m of ($('Lire le registre').first().json.marchands) || []) {\n  annuaire[String(m.id || '').trim()] = m;\n}\n\nconst sorties = [];\n\nfor (const c of contenus) {\n  const m = annuaire[String(c.slug || '').trim()] || {};\n\n  // Texte BRUT, sans balisage. Le marchand va copier-coller ces blocs tels\n  // quels dans Facebook, dans TikTok et dans son statut : des asterisques ou\n  // des balises HTML partiraient avec, et il les publierait sans les voir.\n  const message =\n    '🗓️ Votre publication de la semaine — prête à être publiée\\n' +\n    '🏪 ' + c.nom + '\\n\\n' +\n    '🖼️ Le visuel à télécharger :\\n' + c.urlVisuel + '\\n\\n' +\n    '━━━ FACEBOOK / INSTAGRAM ━━━\\n' + c.legende + '\\n\\n' + c.hashtags + '\\n\\n' +\n    '━━━ TIKTOK ━━━\\n' + c.scriptTikTok + '\\n\\n' +\n    '━━━ STATUT WHATSAPP ━━━\\n' + c.statutWhatsApp;\n\n  sorties.push({ json: {\n    slug: String(c.slug || '').trim(),\n    message: message,\n    telegram: String(m.telegramMarchand || '').trim(),\n    whatsapp: String(m.whatsapp || '').trim(),\n  } });\n}\n\nreturn sorties;"
        },
        "position": [
          672,
          96
        ],
        "type": "n8n-nodes-base.code",
        "typeVersion": 2
      },
