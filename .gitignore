# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# SAUF le modele, qui ne porte que des NOMS de variables et aucune valeur.
# C'est cette regle-ci qui expliquait son absence : le depot referencait 53
# variables et n'en listait aucune, parce que le filet qui protege .env.local
# attrapait aussi le manifeste. Reconstruire apres un incident revenait alors a
# lire tout le code pour deviner ce qui manque.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.env*.local

# outillage agents : local a la machine, ou restaurable depuis skills-lock.json
.claude/settings.local.json
.claude/skills/
.agents/

# graphify : graphe de connaissance regenerable via `graphify update .`
/graphify-out/

# supabase : etat de travail de la CLI, propre a la machine.
# Les migrations, elles, restent versionnees.
/supabase/.temp/

# session Playwright : contient un jeton d’acces valide
tests/e2e/.auth/
captures/
